{
  "name": "@hcaptcha-react/lib",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./hook": {
      "import": "./dist/esm/hooks/index.js",
      "require": "./dist/cjs/hooks/index.js"
    }
  },
  "scripts": {
    "compile:build": "rm -rf ./dist && node ./esbuild.config.js",
    "compile:watch": "WATCH=true rm -rf ./dist && node ./esbuild.config.js",
    "test:types": "tsc -p tsconfig.json",
    "test:unit": "jest --selectProjects unit"
  },
  "dependencies": {
    "@hcaptcha/loader": "^2.4.2"
  },
  "devDependencies": {
    "@hcaptcha/types": "^1.2.0",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "dotenv": "^18.0.9",
    "esbuild": "0.28.2",
    "expect": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "wait-for-expect": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  }
}